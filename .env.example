# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# Dominio con el que se abrirá el sistema (docker compose + Caddy lo usan para HTTPS).
DOMINIO=inventario.ovcorp.pe

# Obligatorio en producción: texto aleatorio de 32+ caracteres. Genéralo con: openssl rand -hex 32
SESSION_SECRET=

# Administrador inicial (solo se usa si la base está vacía). Si no defines la contraseña,
# se genera una aleatoria y se muestra una vez en el log al arrancar. Se debe cambiar en el primer ingreso.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Códigos automáticos: prefijo y cantidad de dígitos (P + 5 dígitos = P00001).
PREFIJO_CODIGO=P
DIGITOS_CODIGO=5

ZONA_HORARIA=America/Lima
MONEDA=S/
PORT=3000
LOG_LEVEL=info

# Sin Docker: ruta de la base de datos SQLite.
# DB_PATH=./data/inventario.db
# Poner en 1 solo si hay un proxy delante (Caddy, Nginx, Render) que agrega X-Forwarded-For.
# TRUST_PROXY=1
# HTTPS directo sin proxy (por ejemplo, certificados de mkcert para la red local).
# SSL_KEY=./certs/key.pem
# SSL_CERT=./certs/cert.pem
