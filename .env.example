# Copia este archivo a .env (o define estas variables en tu servidor).
PORT=3000
SESSION_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
# Usuario administrador que se crea solo la primera vez (base de datos vacía).
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave
# Ruta del archivo de base de datos SQLite.
DB_PATH=./data/inventario.db
ZONA_HORARIA=America/Lima
MONEDA=S/
# Opcional: HTTPS propio para usar la cámara desde celulares en la red local.
# SSL_KEY=./certs/key.pem
# SSL_CERT=./certs/cert.pem
