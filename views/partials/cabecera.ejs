<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof titulo !== 'undefined' ? titulo + ' · ' : '' %>Inventario OV Corp</title>
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<body>
<% if (usuario) { %>
<header class="barra">
  <a class="marca" href="/">OV Corp · Inventario</a>
  <nav>
    <a href="/escanear" class="<%= ruta.startsWith('/escanear') ? 'activo' : '' %>">Escanear</a>
    <a href="/productos" class="<%= ruta.startsWith('/productos') ? 'activo' : '' %>">Productos</a>
    <a href="/movimientos" class="<%= ruta.startsWith('/movimientos') ? 'activo' : '' %>">Movimientos</a>
    <a href="/excel" class="<%= ruta.startsWith('/excel') ? 'activo' : '' %>">Excel</a>
    <% if (usuario.rol === 'admin') { %>
      <a href="/usuarios" class="<%= ruta.startsWith('/usuarios') ? 'activo' : '' %>">Usuarios</a>
    <% } %>
  </nav>
  <form method="post" action="/logout" class="salir">
    <span><%= usuario.nombre %></span>
    <button type="submit" class="boton secundario">Salir</button>
  </form>
</header>
<% } %>
<main>
<% if (flash) { %>
  <div class="aviso <%= flash.tipo %>"><%= flash.mensaje %></div>
<% } %>
