<% const editando = !!producto.id; %>
<%- include('../partials/cabecera', { titulo: editando ? 'Editar producto' : 'Nuevo producto' }) %>
<h1><%= editando ? 'Editar producto' : 'Nuevo producto' %></h1>
<% if (error) { %><div class="aviso error"><%= error %></div><% } %>
<form method="post" action="<%= editando ? `/productos/${producto.id}` : '/productos' %>" class="formulario columnas">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Código<%= editando ? ' *' : '' %>
    <input name="codigo" value="<%= producto.codigo || '' %>" maxlength="64" pattern="[A-Za-z0-9._\-\/]+" <%= editando ? 'required' : '' %>
      placeholder="<%= editando ? '' : 'Automático' %>">
    <small>
      <% if (editando) { %>Cambiarlo invalida las etiquetas QR ya impresas de este producto.
      <% } else { %>Déjalo vacío y el sistema asignará el siguiente código libre (P00001, P00002…). Escríbelo solo si el producto ya trae un código de barras.<% } %>
    </small>
  </label>
  <label>Nombre * <input name="nombre" value="<%= producto.nombre || '' %>" maxlength="200" required></label>
  <label>Categoría <input name="categoria" value="<%= producto.categoria || '' %>" maxlength="100"></label>
  <label>Unidad <input name="unidad" value="<%= producto.unidad || 'UND' %>" maxlength="20"></label>
  <label>Costo (<%= moneda %>) <input name="costo" type="number" step="any" min="0" value="<%= producto.costo ?? 0 %>"></label>
  <label>Precio (<%= moneda %>) <input name="precio" type="number" step="any" min="0" value="<%= producto.precio ?? 0 %>"></label>
  <label>Stock mínimo <input name="stock_minimo" type="number" step="any" min="0" value="<%= producto.stock_minimo ?? 0 %>"></label>
  <label>Ubicación <input name="ubicacion" value="<%= producto.ubicacion || '' %>" maxlength="100" placeholder="Ej. Estante A-01"></label>
  <div class="acciones completo">
    <button class="boton" type="submit">Guardar</button>
    <a class="boton secundario" href="<%= editando ? `/productos/${producto.id}` : '/productos' %>">Cancelar</a>
  </div>
  <% if (!editando) { %>
    <p class="nota completo">El stock inicial se registra después como una "entrada" o un "conteo" desde la ficha del producto o escaneando su etiqueta.</p>
  <% } %>
</form>
<%- include('../partials/pie') %>
