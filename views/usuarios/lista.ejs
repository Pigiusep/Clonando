<%- include('../partials/cabecera', { titulo: 'Usuarios' }) %>
<h1>Usuarios</h1>
<div class="desplazable">
<table class="tabla">
  <thead><tr><th>Usuario</th><th>Nombre</th><th>Rol</th><th>Estado</th><th>Acciones</th></tr></thead>
  <tbody>
  <% for (const u of usuarios) { %>
    <tr class="<%= u.activo ? '' : 'inactivo' %>">
      <td><%= u.usuario %></td><td><%= u.nombre %></td><td><%= u.rol %></td>
      <td><%= u.activo ? 'Activo' : 'Desactivado' %><%= u.debe_cambiar_password ? ' · contraseña temporal' : '' %></td>
      <td>
        <div class="acciones">
        <% if (u.id !== usuario.id) { %>
        <form method="post" action="/usuarios/<%= u.id %>/estado">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="hidden" name="activo" value="<%= u.activo ? '0' : '1' %>">
          <button class="boton secundario" type="submit"><%= u.activo ? 'Desactivar' : 'Activar' %></button>
        </form>
        <form method="post" action="/usuarios/<%= u.id %>/password" class="en-linea">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input name="password" type="password" minlength="10" maxlength="72" placeholder="Contraseña temporal" autocomplete="new-password" required>
          <button class="boton secundario" type="submit">Restablecer</button>
        </form>
        <% } else { %>
          <a class="boton secundario" href="/cuenta/password">Cambiar mi contraseña</a>
        <% } %>
        </div>
      </td>
    </tr>
  <% } %>
  </tbody>
</table>
</div>

<h2>Nuevo usuario</h2>
<% if (error) { %><div class="aviso error"><%= error %></div><% } %>
<form method="post" action="/usuarios" class="formulario columnas">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Usuario <input name="usuario" value="<%= datos.usuario || '' %>" pattern="[a-zA-Z0-9._\-]{3,30}" required></label>
  <label>Nombre <input name="nombre" value="<%= datos.nombre || '' %>" maxlength="100" required></label>
  <label>Contraseña temporal
    <input name="password" type="password" minlength="10" maxlength="72" autocomplete="new-password" required>
    <small>Mínimo 10 caracteres. La persona deberá cambiarla en su primer ingreso.</small>
  </label>
  <label>Rol
    <select name="rol">
      <option value="operador" <%= datos.rol !== 'admin' ? 'selected' : '' %>>Operador (registra movimientos y productos)</option>
      <option value="admin" <%= datos.rol === 'admin' ? 'selected' : '' %>>Administrador (además: usuarios, importar, desactivar)</option>
    </select>
  </label>
  <div class="acciones completo"><button class="boton" type="submit">Crear usuario</button></div>
</form>

<h2>Bitácora de seguridad</h2>
<p class="nota">Últimos 100 eventos: ingresos, intentos fallidos, cambios de usuarios, importaciones y productos desactivados.</p>
<div class="desplazable">
<table class="tabla">
  <thead><tr><th>Fecha</th><th>Usuario</th><th>Acción</th><th>Detalle</th><th>IP</th></tr></thead>
  <tbody>
  <% for (const a of auditoria) { %>
    <tr><td class="fecha"><%= a.creado_en %></td><td><%= a.usuario || '—' %></td><td><%= a.accion.replaceAll('_', ' ') %></td><td><%= a.detalle %></td><td><%= a.ip %></td></tr>
  <% } %>
  </tbody>
</table>
</div>
<%- include('../partials/pie') %>
